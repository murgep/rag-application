APP_ENV=development
LOCAL_AUTH_ENABLED=true

JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-bytes
JWT_ISSUER=rag-local
JWT_AUDIENCE=rag-api
JWT_ACCESS_TOKEN_MINUTES=15

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ragdb
DATABASE_USER=raguser
DATABASE_PASSWORD=replace-with-a-local-database-password
